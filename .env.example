DATABASE_URL='postgresql://postgres:password@localhost:5432/boutique?schema=public'
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
NODE_ENV=development
PORT=8001

# Seed credentials (used by prisma/seed.ts)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=Admin@123

# CORS — comma-separated list of allowed origins in production
CORS_ORIGINS=https://your-crm-domain.com,http://localhost:3000

# Set to 1 only when the API sits behind exactly one reverse proxy.
# Leave unset when Node is reached directly, or rate limits follow a client-supplied address.
# TRUST_PROXY=1

# Catalog GETs per minute per client. Orders, leads, and tracking keep their own tighter limits.
# PUBLIC_READ_RATE_LIMIT_MAX=3000
# Short cache for public catalog GETs, in milliseconds. 0 disables it.
# PUBLIC_READ_CACHE_MS=10000

# Public Website API
# Generate a strong key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_API_KEY=change-this-to-a-strong-random-key-in-production
WEBSITE_ORIGIN=https://yourclientwebsite.com

# WhatsApp notifications via WATI (https://www.wati.io)
WATI_API_URL=https://live-server-XXXXX.wati.io
WATI_ACCESS_TOKEN=your-wati-access-token
WATI_NOTIFY_PHONE=919XXXXXXXXX
WATI_ENQUIRY_TEMPLATE=enquiry_received

# Cloudflare R2 (S3-compatible) object storage
# Account ID: find in Cloudflare dashboard → R2
# Region is always "auto" for R2
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=your-r2-bucket-name
S3_REGION=auto
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
S3_PUBLIC_ENDPOINT=https://your-r2-public-domain.com
# Storage folder prefix — change per environment to isolate files in the same bucket
# production:  STORAGE_PREFIX=boutique
# staging:     STORAGE_PREFIX=boutique-staging
STORAGE_PREFIX=boutique

# Production Swagger server URL (optional — shown in /api-docs)
# API_URL=https://api.yourdomain.com
