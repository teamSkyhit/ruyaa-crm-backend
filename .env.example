# ── Required ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ruyaaessentials?schema=public
JWT_SECRET=                          # min 32 chars — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_JWT_SECRET=                 # separate secret for storefront customer tokens
CUSTOMER_JWT_EXPIRES_IN=15m
CUSTOMER_REFRESH_EXPIRES_IN=30d

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8001
NODE_ENV=development
TRUST_PROXY=                         # set 1 if behind a reverse proxy (Railway, nginx)

# ── CORS / Origins ─────────────────────────────────────────────────────────────
WEBSITE_ORIGIN=https://ruyaaessentials.com
STOREFRONT_URL=http://localhost:3000
CORS_ORIGINS=                        # comma-separated extra origins (optional)
FRONTEND_URL=                        # alias for storefront (optional)

# ── Public Storefront API ──────────────────────────────────────────────────────
PUBLIC_API_KEY=                      # shared key sent in X-API-Key header by the storefront

# ── Bootstrap Admin (first-run only) ──────────────────────────────────────────
# Leave blank — seed.ts creates admin@ruyaaessentials.com / Admin@123 (change on first login)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# ── Cloudflare R2 (file uploads) ──────────────────────────────────────────────
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=ruyaa-staging
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_ENDPOINT=                  # public R2 URL once bucket is publicly accessible
STORAGE_PREFIX=ruyaa

# ── Razorpay (configure via CRM → System Config after first login) ─────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=             # verify incoming Razorpay webhook signatures

# ── Resend (email sending — configure via CRM → System Config) ────────────────
RESEND_API_KEY=
ADMIN_EMAIL=                         # destination for admin notifications
API_URL=                             # backend's own public URL (used in email links)

# ── Shiprocket ─────────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=          # name of the pickup address in Shiprocket dashboard
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_WEBHOOK_TOKEN=            # token to verify Shiprocket webhook calls

# ── WhatsApp (Interakt) ────────────────────────────────────────────────────────
WHATSAPP_API_KEY=                    # empty = WhatsApp sends skipped silently
WHATSAPP_BASE_URL=https://api.interakt.ai/v1/public/message/

# ── Rate Limit Tuning (all optional — sensible defaults apply) ─────────────────
# AUTH_RATE_LIMIT_MAX=
# FORGOT_PASSWORD_RATE_LIMIT_MAX=
# RESET_PASSWORD_RATE_LIMIT_MAX=
# PUBLIC_READ_RATE_LIMIT_MAX=
# PUBLIC_ORDER_RATE_LIMIT_MAX=
# PUBLIC_LEAD_RATE_LIMIT_MAX=
# PUBLIC_TRACK_RATE_LIMIT_MAX=
# PUBLIC_READ_CACHE_MS=

# ── Security / Lockout ─────────────────────────────────────────────────────────
# LOCKOUT_ATTEMPTS=
# LOCKOUT_DURATION_MS=

# ── Misc ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
JSON_BODY_LIMIT=100kb
