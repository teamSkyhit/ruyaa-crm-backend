generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
}

enum EntityType {
  PRODUCT
  USER
  CATEGORY
  ORDER
  CUSTOMER
  BANNER
  SITE_SETTINGS
  ENQUIRY
  SUBCATEGORY
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum NotificationType {
  NEW_ORDER
  PAYMENT_FAILED
  SHIPMENT_FAILED
  NEW_ENQUIRY
  LOW_STOCK
  NEW_TICKET
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum TicketAuthor {
  CUSTOMER
  STAFF
}

// COD orders: created with CONFIRMED + paymentStatus PENDING
// Razorpay orders: created with PENDING_PAYMENT, moved to CONFIRMED after signature verification
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
  CASH  // POS only
  UPI   // POS only
  CARD  // POS only
}

// ONLINE = storefront / website; POS = counter sale via CRM
enum OrderChannel {
  ONLINE
  POS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  INITIATED
  PROCESSED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  BOGO
  COMBO
}

enum MediaKind {
  IMAGE
  VIDEO
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String     @db.VarChar(100)
  email               String     @unique @db.VarChar(255)
  role                UserRole   @default(USER)
  status              UserStatus @default(ACTIVE)
  passwordHash        String     @db.VarChar(255)
  passwordResetToken  String?    @unique @db.VarChar(255)
  passwordResetExpiry DateTime?  @db.Timestamptz(6)
  lastLoginAt         DateTime?  @db.Timestamptz(6)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(6)

  activityLogs    ActivityLog[]
  refreshTokens   RefreshToken[]
  cancelledOrders Order[]        @relation("CancelledByUser")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  image       String?  @db.Text
  imageAlt    String?  @db.VarChar(255)
  slug        String   @unique @db.VarChar(100)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  canonicalUrl    String?  @db.Text
  ogTitle         String?  @db.VarChar(255)
  ogDescription   String?  @db.Text
  ogImage         String?  @db.Text
  robotsIndex     Boolean  @default(true)
  robotsFollow    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  products      Product[]
  subcategories Subcategory[]

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Subcategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String   @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  image       String?  @db.Text
  imageAlt    String?  @db.VarChar(255)
  slug        String   @unique @db.VarChar(100)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  canonicalUrl    String?  @db.Text
  ogTitle         String?  @db.VarChar(255)
  ogDescription   String?  @db.Text
  ogImage         String?  @db.Text
  robotsIndex     Boolean  @default(true)
  robotsFollow    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([categoryId, isActive, sortOrder])
  @@map("subcategories")
}

// IMPORTANT: Never use findFirst→update for stock decrement.
// Always use atomic SQL: UPDATE products SET quantity = quantity - $qty
// WHERE id = $id AND quantity >= $qty — then check rowsAffected = 1.
model Product {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String   @db.VarChar(200)
  slug                String   @unique @db.VarChar(255)
  sku                 String   @unique @db.VarChar(20)
  categoryId          String   @db.Uuid
  subcategoryId       String?  @db.Uuid
  sortOrder           Int      @default(0)

  // Pricing — mrp is required; current price = salePrice ?? mrp
  mrp       Decimal  @db.Decimal(10, 2)
  salePrice Decimal? @db.Decimal(10, 2)

  // Core
  weight      String  @default("125g") @db.VarChar(50)
  description String? @db.Text

  // Ingredients
  featuredIngredients String[]
  fullIngredients     String?  @db.Text

  // Product info
  shelfLife           String? @db.VarChar(100)
  howToUse            String? @db.Text
  storageInstructions String? @db.Text
  manufacturer        String? @db.VarChar(255)
  licenceNumber       String? @db.VarChar(100)

  // Images
  image  String?  @db.Text
  images String[]

  // Inventory
  quantity          Int @default(0)
  lowStockThreshold Int @default(10)

  // Visibility
  isActive      Boolean @default(true)
  showOnWebsite Boolean @default(false)

  // SEO
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.Text
  canonicalUrl    String? @db.Text
  ogTitle         String? @db.VarChar(255)
  ogDescription   String? @db.Text
  ogImage         String? @db.Text
  imageAlt        String? @db.VarChar(255)
  robotsIndex     Boolean @default(true)
  robotsFollow    Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  enquiries  Enquiry[]
  reviews    Review[]
  wishlist   WishlistItem[]
  variants   ProductVariant[]
  benefits   ProductBenefit[]
  packCards  PackCard[]
  faqs       Faq[]
  media      ProductMedia[]
  highlights ProductHighlight[]
  relatedProducts RelatedProduct[] @relation("RelatedFrom")
  relatedOf       RelatedProduct[] @relation("RelatedTo")

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([name])
  @@index([isActive])
  @@index([showOnWebsite])
  @@index([sortOrder])
  // Public storefront listing: WHERE isActive = true ORDER BY sortOrder
  @@index([isActive, sortOrder])
  // Public newest listing: WHERE isActive = true ORDER BY createdAt DESC
  @@index([isActive, createdAt])
  // Public storefront with category filter: WHERE categoryId = X AND isActive = true
  @@index([categoryId, isActive, sortOrder])
  @@map("products")
}

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?  @db.VarChar(100)
  email     String?  @unique @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  addresses     Address[]
  wishlist      WishlistItem[]
  orders        Order[]
  otps          CustomerOtp[]
  refreshTokens CustomerRefreshToken[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model CustomerOtp {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @db.VarChar(255)
  otp        String   @db.VarChar(64)
  expiresAt  DateTime @db.Timestamptz(6)
  used       Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  customerId String?  @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([email, createdAt])
  @@map("customer_otps")
}

model CustomerRefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customerId String    @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_refresh_tokens")
}

model WishlistItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("wishlist_items")
}

model ProductVariant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @db.Uuid
  name           String   @db.VarChar(100)
  sku            String?  @db.VarChar(100)
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  quantity       Int      @default(0)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  media          ProductMedia[]

  @@index([productId])
  @@map("product_variants")
}

model ProductBenefit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @db.Uuid
  title       String   @db.VarChar(120)
  description String   @db.Text
  image       String?  @db.Text
  imageAlt    String?  @db.VarChar(255)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive, sortOrder])
  @@map("product_benefits")
}

model ProductMedia {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String    @db.Uuid
  variantId    String?   @db.Uuid
  kind         MediaKind
  url          String    @db.Text
  thumbnailUrl String?   @db.Text
  altText      String?   @db.VarChar(255)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, variantId, isActive, sortOrder])
  @@map("product_media")
}

model ProductHighlight {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @db.Uuid
  title       String   @db.VarChar(120)
  description String?  @db.Text
  image       String?  @db.Text
  imageAlt    String?  @db.VarChar(255)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive, sortOrder])
  @@map("product_highlights")
}

model RelatedProduct {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String @db.Uuid
  relatedProductId String @db.Uuid
  sortOrder        Int    @default(0)

  product Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId])
  @@index([productId, sortOrder])
  @@map("related_products")
}

model PackCard {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String?  @db.Uuid
  title          String   @db.VarChar(120)
  subtitle       String?  @db.VarChar(120)
  badge          String?  @db.VarChar(80)
  image          String?  @db.Text
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isActive, sortOrder])
  @@index([productId])
  @@map("pack_cards")
}

model Blog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  excerpt     String?   @db.Text
  body        String    @db.Text
  coverUrl    String?   @db.VarChar(500)
  coverAlt    String?   @db.VarChar(255)
  tags        String[]
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.Text
  canonicalUrl    String?  @db.Text
  ogTitle         String?  @db.VarChar(255)
  ogDescription   String?  @db.Text
  ogImage         String?  @db.Text
  robotsIndex     Boolean  @default(true)
  robotsFollow    Boolean  @default(true)
  authorName  String    @default("Ruyaa Team") @db.VarChar(100)
  isPublished Boolean   @default(false)
  publishedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  @@index([isPublished, publishedAt])
  @@map("blogs")
}

model PincodeZone {
  pincode       String  @id @db.VarChar(6)
  city          String  @db.VarChar(100)
  state         String  @db.VarChar(100)
  deliverable   Boolean @default(true)
  estimatedDays Int     @default(5)

  @@map("pincode_zones")
}

model Address {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String   @db.Uuid
  label        String?  @db.VarChar(50)
  fullName     String   @db.VarChar(100)
  phone        String   @db.VarChar(20)
  addressLine1 String   @db.VarChar(255)
  addressLine2 String?  @db.VarChar(255)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(100)
  pincode      String   @db.VarChar(10)
  country      String   @default("India") @db.VarChar(100)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

// Order number (RYA-000001) is generated by incrementing SystemConfig key="order_number_seq"
// inside the same $transaction as the Order insert to prevent gaps and race conditions.
model Order {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber String @unique @db.VarChar(20)

  // Customer — nullable for guest checkout
  customerId     String? @db.Uuid
  savedAddressId String? @db.Uuid

  // Customer snapshot (always filled — guest or logged-in)
  customerName  String @db.VarChar(100)
  customerEmail String @db.VarChar(255)
  customerPhone String @db.VarChar(20)

  // Shipping address snapshot (mirrors Address model exactly)
  shippingFullName     String  @db.VarChar(100)
  shippingPhone        String  @db.VarChar(20)
  shippingAddressLine1 String  @db.VarChar(255)
  shippingAddressLine2 String? @db.VarChar(255)
  shippingCity         String  @db.VarChar(100)
  shippingState        String  @db.VarChar(100)
  shippingPincode      String  @db.VarChar(10)
  shippingCountry      String  @default("India") @db.VarChar(100)

  // Pricing
  subtotal            Decimal @db.Decimal(10, 2)
  shippingCharge      Decimal @default(0) @db.Decimal(10, 2)
  freeShippingApplied Boolean @default(false)
  discount            Decimal @default(0) @db.Decimal(10, 2)
  discountCode        String? @db.VarChar(50)
  total               Decimal @db.Decimal(10, 2)

  // Status
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  channel       OrderChannel  @default(ONLINE)

  // Razorpay — unique so webhook retries can't double-process
  razorpayOrderId   String? @unique @db.VarChar(100)
  razorpayPaymentId String? @unique @db.VarChar(100)
  razorpaySignature String? @db.VarChar(255)

  // Shipping
  trackingNumber    String? @db.VarChar(100)
  courierName       String? @db.VarChar(100)
  courierStatus     String? @db.VarChar(100)
  trackingUrl       String? @db.Text
  shiprocketOrderId String? @db.VarChar(100)
  shipmentId        String? @db.VarChar(100)

  // Notes
  customerNotes String? @db.Text
  adminNotes    String? @db.Text

  // Cancellation audit
  cancelledById      String? @db.Uuid
  cancellationReason String? @db.Text

  // Discount foreign key (links to DiscountCode record for usage tracking)
  discountCodeId String? @db.Uuid

  // Prevents double-submit (especially for COD)
  idempotencyKey String? @unique @db.VarChar(100)

  // Lifecycle timestamps
  paidAt      DateTime? @db.Timestamptz(6)
  confirmedAt DateTime? @db.Timestamptz(6)
  shippedAt   DateTime? @db.Timestamptz(6)
  deliveredAt           DateTime? @db.Timestamptz(6)
  cancelledAt           DateTime? @db.Timestamptz(6)
  reviewRequestSentAt   DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cancelledBy  User?         @relation("CancelledByUser", fields: [cancelledById], references: [id], onDelete: SetNull)
  discountCodeRef DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  refunds      Refund[]
  reviews      Review[]
  tickets      SupportTicket[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([razorpayOrderId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([channel])
  @@index([trackingNumber])
  // Revenue dashboard queries filter by confirmedAt date range
  @@index([confirmedAt])
  // Admin order list: filter by status + sort by date
  @@index([paymentStatus, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @db.Uuid
  productId String? @db.Uuid // nullable — product may be deleted post-order

  // Product snapshot
  productName  String  @db.VarChar(200)
  productSku   String  @db.VarChar(20)
  productImage String? @db.Text
  productSlug  String  @db.VarChar(255) // non-nullable — needed for order confirmation email

  variantId String? @db.Uuid

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

// Refund model — stores Razorpay refund IDs and manual refund records.
// Disabled at API layer until CEO confirms refund workflow.
model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String       @db.Uuid
  razorpayRefundId String?      @unique @db.VarChar(100) // null for manual/COD refunds
  amount           Decimal      @db.Decimal(10, 2)
  reason           String?      @db.Text
  status           RefundStatus @default(INITIATED)
  initiatedById    String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("refunds")
}

// Prevents Razorpay webhook retries from double-processing payments or double-sending emails.
model WebhookEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String   @db.VarChar(50)
  eventId     String   @unique @db.VarChar(100)
  payload     Json
  processedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([provider])
  @@map("webhook_events")
}

model ActivityLog {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType EntityType
  entityId   String     @db.Uuid
  entityName String     @db.VarChar(200)
  action     ActionType
  details    String?    @db.Text
  ipAddress  String?    @db.VarChar(45)
  userId     String?    @db.Uuid
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([entityId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

model Enquiry {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String        @db.VarChar(200)
  phone     String        @db.VarChar(20)
  email     String?       @db.VarChar(255)
  productId String?       @db.Uuid
  message   String        @db.Text
  status    EnquiryStatus @default(NEW)
  notes     String?       @db.Text
  ipAddress String?       @db.VarChar(45)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  ticket  SupportTicket?

  @@index([productId])
  @@index([status])
  @@index([phone])
  @@index([createdAt])
  @@map("enquiries")
}

model AdminNotification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.Text
  link      String?          @db.VarChar(255)
  readAt    DateTime?        @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@index([readAt, createdAt])
  @@index([type, link, createdAt])
  @@map("admin_notifications")
}

model SupportTicket {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber String       @unique @db.VarChar(20)
  name         String       @db.VarChar(200)
  phone        String       @db.VarChar(20)
  email        String?      @db.VarChar(255)
  subject      String       @db.VarChar(200)
  status       TicketStatus @default(OPEN)
  orderId      String?      @db.Uuid
  enquiryId    String?      @unique @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)

  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  enquiry  Enquiry?         @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([status, createdAt])
  @@index([orderId])
  @@index([phone])
  @@map("support_tickets")
}

model SupportMessage {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String       @db.Uuid
  author    TicketAuthor
  body      String       @db.Text
  createdAt DateTime     @default(now()) @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// Singleton — always query via findUnique({ where: { singleton: "global" } })
// Only public-safe fields here. Secrets (Razorpay keys, Resend key) live in SystemConfig.
model SiteSettings {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton String @unique @default("global") @db.VarChar(20)

  // Branding
  brandName  String  @default("Ruyaa Essentials") @db.VarChar(100)
  tagline    String? @db.VarChar(255)
  logoUrl    String? @db.Text
  logoAlt    String? @db.VarChar(255)
  faviconUrl String? @db.Text

  // Contact
  contactEmail   String? @db.VarChar(255)
  contactPhone   String? @db.VarChar(20)
  whatsappNumber String? @db.VarChar(20)
  address        String? @db.Text
  googleMapsUrl  String? @db.Text

  // Social
  instagramUrl String? @db.Text
  facebookUrl  String? @db.Text
  youtubeUrl   String? @db.Text
  pinterestUrl String? @db.Text

  // SEO defaults
  defaultMetaTitle                String? @db.VarChar(255)
  defaultMetaDescription          String? @db.Text
  defaultOgImage                  String? @db.Text
  googleAnalyticsId               String? @db.VarChar(50)
  googleSearchConsoleVerification String? @db.VarChar(255)

  // Homepage content
  heroTitle     String? @db.VarChar(255)
  heroSubtitle  String? @db.Text
  heroCTAText   String? @db.VarChar(100)
  aboutTitle    String? @db.VarChar(255)
  aboutText     String? @db.Text
  aboutImageUrl String? @db.Text

  // Announcement bar
  announcementBarEnabled Boolean @default(false)
  announcementBarText    String? @db.VarChar(255)
  announcementBarLink    String? @db.Text

  // Payments — secrets live in SystemConfig, not here
  codEnabled                    Boolean @default(true)
  orderConfirmationEmailEnabled Boolean @default(true)

  // Shipping
  shippingCharge        Decimal  @default(0) @db.Decimal(10, 2)
  freeShippingThreshold Decimal? @db.Decimal(10, 2)
  estimatedDeliveryDays String?  @db.VarChar(50)

  // Policies
  returnPolicy   String? @db.Text
  privacyPolicy  String? @db.Text
  termsOfService String? @db.Text
  shippingPolicy String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("site_settings")
}

// Internal key-value store for secrets and operational counters.
// Keys in use:
//   "order_number_seq"   — current order number counter (e.g. "142")
//   "razorpay_key_id"    — Razorpay Key ID
//   "razorpay_key_secret"— Razorpay Key Secret
//   "resend_api_key"     — Resend API key
//   "from_email"         — sender email address
// NEVER expose this model via any public API endpoint.
model SystemConfig {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("system_config")
}

model Banner {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String?   @db.VarChar(255)
  subtitle       String?   @db.Text
  imageUrl       String    @db.Text
  mobileImageUrl String?   @db.Text
  ctaText        String?   @db.VarChar(100)
  ctaUrl         String?   @db.Text
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  validFrom      DateTime? @db.Timestamptz(6)
  validUntil     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("banners")
}

model NewsletterSubscriber {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  source       String   @default("website") @db.VarChar(50)
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive])
  @@map("newsletter_subscribers")
}

model Faq {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question  String   @db.VarChar(500)
  answer    String   @db.Text
  category  String?  @db.VarChar(100)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  productId String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isActive, sortOrder])
  @@index([productId])
  @@map("faqs")
}

model DiscountCode {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String       @unique @db.VarChar(50)
  type            DiscountType @default(PERCENTAGE)
  value           Decimal      @db.Decimal(10, 2)
  minOrderAmount  Decimal?     @db.Decimal(10, 2)
  maxUses         Int?
  usedCount       Int          @default(0)
  isActive        Boolean      @default(true)
  validFrom       DateTime?    @db.Timestamptz(6)
  validUntil      DateTime?    @db.Timestamptz(6)
  bogoProductId   String?      @db.Uuid
  comboProductIds String[]
  comboDiscount   Decimal?     @db.Decimal(10, 2)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  orders Order[]

  @@index([code])
  @@index([isActive])
  @@map("discount_codes")
}

model Review {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String       @db.Uuid
  orderId       String?      @db.Uuid
  customerName  String       @db.VarChar(100)
  customerEmail String       @db.VarChar(255)
  rating        Int
  title         String?      @db.VarChar(200)
  comment       String?      @db.Text
  status        ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([status])
  @@index([customerEmail])
  @@map("reviews")
}
